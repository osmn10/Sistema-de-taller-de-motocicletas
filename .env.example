# Copia este archivo a `.env` y ajusta los valores.
# El archivo .env nunca debe versionarse (está en .gitignore).

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=cambia-este-valor-por-uno-aleatorio
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Base de datos
# En desarrollo se usa SQLite y NO es necesario definir DATABASE_URL.
# Descomentar y configurar para producción (PostgreSQL).
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_db
